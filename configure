#!/bin/sh

# Find netcdf via nc-config, pkg-config, or common paths

NETCDF_CPPFLAGS=""
NETCDF_LIBS=""
NETCDF_LIBDIR=""

if command -v nc-config > /dev/null 2>&1; then
  NETCDF_CPPFLAGS=$(nc-config --cflags 2>/dev/null)
  NETCDF_LIBS=$(nc-config --libs 2>/dev/null)
  NETCDF_LIBDIR=$(nc-config --prefix 2>/dev/null)/lib
elif command -v pkg-config > /dev/null 2>&1 && pkg-config --exists netcdf 2>/dev/null; then
  NETCDF_CPPFLAGS=$(pkg-config --cflags netcdf 2>/dev/null)
  NETCDF_LIBS=$(pkg-config --libs netcdf 2>/dev/null)
  NETCDF_LIBDIR=$(pkg-config --variable=libdir netcdf 2>/dev/null)
else
  for prefix in /usr/local /usr /opt/homebrew /opt/local; do
    if [ -f "${prefix}/include/netcdf.h" ]; then
      NETCDF_CPPFLAGS="-I${prefix}/include"
      NETCDF_LIBS="-L${prefix}/lib -lnetcdf"
      NETCDF_LIBDIR="${prefix}/lib"
      break
    fi
  done
fi

if [ -z "${NETCDF_LIBS}" ]; then
  echo "-----------------------------------------------------"
  echo "ERROR: netcdf library not found."
  echo ""
  echo "Install netcdf-c (>= 4.0) and ensure nc-config or"
  echo "pkg-config can find it."
  echo ""
  echo "  macOS:   brew install netcdf"
  echo "  Ubuntu:  apt install libnetcdf-dev"
  echo "  Fedora:  dnf install netcdf-devel"
  echo "-----------------------------------------------------"
  exit 1
fi

# Add rpath on macOS so dylib is found at runtime
case "$(uname -s)" in
  Darwin*)
    if [ -n "${NETCDF_LIBDIR}" ]; then
      NETCDF_LIBS="${NETCDF_LIBS} -Wl,-rpath,${NETCDF_LIBDIR}"
    fi
    ;;
esac

# Detect OpenMP support
# On Linux, gcc supports -fopenmp natively.
# On macOS, Apple Clang requires libomp but R ships an older version that
# conflicts with Homebrew's. We only enable OpenMP on macOS if the user has
# explicitly set SHLIB_OPENMP_CXXFLAGS in ~/.R/Makevars (indicating a
# compatible setup). Otherwise macOS runs single-threaded.
OPENMP_CXXFLAGS=""
OPENMP_LIBS=""

case "$(uname -s)" in
  Linux*)
    OPENMP_CXXFLAGS="-fopenmp"
    OPENMP_LIBS="-fopenmp"
    ;;
  Darwin*)
    # Respect user's explicit OpenMP configuration if set
    if [ -n "${SHLIB_OPENMP_CXXFLAGS}" ]; then
      OPENMP_CXXFLAGS="${SHLIB_OPENMP_CXXFLAGS}"
      OPENMP_LIBS="${SHLIB_OPENMP_CXXFLAGS}"
    fi
    # Otherwise: no OpenMP on macOS by default (avoids libomp version conflict)
    ;;
esac

echo "Using netcdf:"
echo "  CPPFLAGS: ${NETCDF_CPPFLAGS}"
echo "  LIBS:     ${NETCDF_LIBS}"
echo "Using OpenMP:"
if [ -n "${OPENMP_CXXFLAGS}" ]; then
  echo "  CXXFLAGS: ${OPENMP_CXXFLAGS}"
else
  echo "  disabled (single-threaded; see ?heatwave3 for enabling on macOS)"
fi

sed -e "s|@NETCDF_CPPFLAGS@|${NETCDF_CPPFLAGS}|" \
    -e "s|@NETCDF_LIBS@|${NETCDF_LIBS}|" \
    -e "s|@OPENMP_CXXFLAGS@|${OPENMP_CXXFLAGS}|" \
    -e "s|@OPENMP_LIBS@|${OPENMP_LIBS}|" \
    src/Makevars.in > src/Makevars

exit 0
