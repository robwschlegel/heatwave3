#!/bin/sh
# configure — find netcdf and auto-detect OpenMP (including macOS)
#
# OpenMP detection follows the data.table approach: compile a small test
# program, link it with R CMD SHLIB, and run a parallel reduction to verify
# the runtime works. This catches the macOS libomp version mismatch that
# causes ___kmpc_dispatch_deinit failures at runtime.

set -e

# ---- NetCDF detection -------------------------------------------------------

NETCDF_CPPFLAGS=""
NETCDF_LIBS=""
NETCDF_LIBDIR=""

if command -v nc-config > /dev/null 2>&1; then
  NETCDF_CPPFLAGS=$(nc-config --cflags 2>/dev/null)
  NETCDF_LIBS=$(nc-config --libs 2>/dev/null)
  NETCDF_LIBDIR=$(nc-config --prefix 2>/dev/null)/lib
elif command -v pkg-config > /dev/null 2>&1 && pkg-config --exists netcdf 2>/dev/null; then
  NETCDF_CPPFLAGS=$(pkg-config --cflags netcdf 2>/dev/null)
  NETCDF_LIBS=$(pkg-config --libs netcdf 2>/dev/null)
  NETCDF_LIBDIR=$(pkg-config --variable=libdir netcdf 2>/dev/null)
else
  for prefix in /usr/local /usr /opt/homebrew /opt/local; do
    if [ -f "${prefix}/include/netcdf.h" ]; then
      NETCDF_CPPFLAGS="-I${prefix}/include"
      NETCDF_LIBS="-L${prefix}/lib -lnetcdf"
      NETCDF_LIBDIR="${prefix}/lib"
      break
    fi
  done
fi

if [ -z "${NETCDF_LIBS}" ]; then
  echo "-----------------------------------------------------"
  echo "ERROR: netcdf library not found."
  echo ""
  echo "Install netcdf-c (>= 4.0) and ensure nc-config or"
  echo "pkg-config can find it."
  echo ""
  echo "  macOS:   brew install netcdf"
  echo "  Ubuntu:  apt install libnetcdf-dev"
  echo "  Fedora:  dnf install netcdf-devel"
  echo "-----------------------------------------------------"
  exit 1
fi

# Add rpath on macOS so dylib is found at runtime
case "$(uname -s)" in
  Darwin*)
    if [ -n "${NETCDF_LIBDIR}" ]; then
      NETCDF_LIBS="${NETCDF_LIBS} -Wl,-rpath,${NETCDF_LIBDIR}"
    fi
    ;;
esac

# ---- OpenMP detection (compile-link-run test) -------------------------------

OPENMP_CXXFLAGS=""
OPENMP_LIBS=""

# Write a small test program that uses schedule(dynamic) — the construct
# that triggers the ___kmpc_dispatch_deinit symbol issue on macOS
TMPDIR="${TMPDIR:-/tmp}"
TEST_SRC="${TMPDIR}/hw3_omp_test.cpp"
TEST_OUT="${TMPDIR}/hw3_omp_test.so"

cat > "${TEST_SRC}" << 'OMPTEST'
#include <omp.h>
extern "C" {
  void hw3_omp_test(int* result) {
    int sum = 0;
    #pragma omp parallel for schedule(dynamic) reduction(+:sum)
    for (int i = 0; i < 100; i++) sum += i;
    *result = sum;
  }
}
OMPTEST

# R's compiler and flags
: "${R_HOME=$(R RHOME 2>/dev/null)}"
CXX=$("${R_HOME}/bin/R" CMD config CXX17 2>/dev/null || "${R_HOME}/bin/R" CMD config CXX 2>/dev/null)
CXXFLAGS=$("${R_HOME}/bin/R" CMD config CXX17FLAGS 2>/dev/null || "${R_HOME}/bin/R" CMD config CXXFLAGS 2>/dev/null)
LDFLAGS=$("${R_HOME}/bin/R" CMD config LDFLAGS 2>/dev/null)
SHLIB_CXXFLAGS=$("${R_HOME}/bin/R" CMD config SHLIB_CXX17FLAGS 2>/dev/null || echo "")

# Test one OpenMP variant: compile, link, and run
test_openmp() {
  OMP_CFLAGS="$1"
  OMP_LIBS="$2"
  EXTRA_DESC="$3"

  ${CXX} ${CXXFLAGS} ${SHLIB_CXXFLAGS} -std=gnu++17 ${OMP_CFLAGS} \
    -shared -fPIC -o "${TEST_OUT}" "${TEST_SRC}" ${OMP_LIBS} ${LDFLAGS} \
    > /dev/null 2>&1 || return 1

  # Try to load and run in R
  "${R_HOME}/bin/Rscript" --vanilla -e "
    dyn.load('${TEST_OUT}')
    r <- integer(1)
    .C('hw3_omp_test', r)
    if (r != 4950L) quit(status = 1)
  " > /dev/null 2>&1 || return 1

  return 0
}

# Clean up on exit
cleanup_omp_test() {
  rm -f "${TEST_SRC}" "${TEST_OUT}" 2>/dev/null
}
trap cleanup_omp_test EXIT

echo "Detecting OpenMP..."

# Try variants in order of preference
FOUND_OMP=0

# 1. User-specified flags (highest priority)
if [ -n "${SHLIB_OPENMP_CXXFLAGS}" ]; then
  echo "  Trying user SHLIB_OPENMP_CXXFLAGS: ${SHLIB_OPENMP_CXXFLAGS}"
  if test_openmp "${SHLIB_OPENMP_CXXFLAGS}" "${SHLIB_OPENMP_CXXFLAGS}" "user flags"; then
    OPENMP_CXXFLAGS="${SHLIB_OPENMP_CXXFLAGS}"
    OPENMP_LIBS="${SHLIB_OPENMP_CXXFLAGS}"
    FOUND_OMP=1
    echo "  -> works"
  else
    echo "  -> failed"
  fi
fi

# 2. Standard -fopenmp (Linux gcc, MinGW)
if [ ${FOUND_OMP} -eq 0 ]; then
  echo "  Trying -fopenmp"
  if test_openmp "-fopenmp" "-fopenmp" "standard"; then
    OPENMP_CXXFLAGS="-fopenmp"
    OPENMP_LIBS="-fopenmp"
    FOUND_OMP=1
    echo "  -> works"
  else
    echo "  -> failed"
  fi
fi

# 3. Apple Clang: -Xclang -fopenmp with -lomp (R's bundled libomp)
if [ ${FOUND_OMP} -eq 0 ]; then
  echo "  Trying -Xclang -fopenmp -lomp (Apple Clang + R libomp)"
  if test_openmp "-Xclang -fopenmp" "-lomp" "Apple Clang"; then
    OPENMP_CXXFLAGS="-Xclang -fopenmp"
    OPENMP_LIBS="-lomp"
    FOUND_OMP=1
    echo "  -> works"
  else
    echo "  -> failed"
  fi
fi

# 4. Homebrew libomp (macOS ARM64)
if [ ${FOUND_OMP} -eq 0 ] && [ -d "/opt/homebrew/opt/libomp" ]; then
  HB_INC="-I/opt/homebrew/opt/libomp/include"
  HB_LIB="-L/opt/homebrew/opt/libomp/lib -lomp -Wl,-rpath,/opt/homebrew/opt/libomp/lib"
  echo "  Trying Homebrew libomp (ARM64)"
  if test_openmp "-Xclang -fopenmp ${HB_INC}" "${HB_LIB}" "Homebrew ARM64"; then
    OPENMP_CXXFLAGS="-Xclang -fopenmp ${HB_INC}"
    OPENMP_LIBS="${HB_LIB}"
    FOUND_OMP=1
    echo "  -> works"
  else
    echo "  -> failed"
  fi
fi

# 5. Homebrew libomp (macOS Intel)
if [ ${FOUND_OMP} -eq 0 ] && [ -d "/usr/local/opt/libomp" ]; then
  HB_INC="-I/usr/local/opt/libomp/include"
  HB_LIB="-L/usr/local/opt/libomp/lib -lomp -Wl,-rpath,/usr/local/opt/libomp/lib"
  echo "  Trying Homebrew libomp (Intel)"
  if test_openmp "-Xclang -fopenmp ${HB_INC}" "${HB_LIB}" "Homebrew Intel"; then
    OPENMP_CXXFLAGS="-Xclang -fopenmp ${HB_INC}"
    OPENMP_LIBS="${HB_LIB}"
    FOUND_OMP=1
    echo "  -> works"
  else
    echo "  -> failed"
  fi
fi

# Report results
echo ""
echo "Using netcdf:"
echo "  CPPFLAGS: ${NETCDF_CPPFLAGS}"
echo "  LIBS:     ${NETCDF_LIBS}"
echo "Using OpenMP:"
if [ ${FOUND_OMP} -eq 1 ]; then
  echo "  CXXFLAGS: ${OPENMP_CXXFLAGS}"
  echo "  LIBS:     ${OPENMP_LIBS}"
else
  echo "  disabled (no working OpenMP found)"
  echo "  heatwave3 will run single-threaded."
  echo "  See https://mac.r-project.org/openmp/ for macOS instructions."
fi

sed -e "s|@NETCDF_CPPFLAGS@|${NETCDF_CPPFLAGS}|" \
    -e "s|@NETCDF_LIBS@|${NETCDF_LIBS}|" \
    -e "s|@OPENMP_CXXFLAGS@|${OPENMP_CXXFLAGS}|" \
    -e "s|@OPENMP_LIBS@|${OPENMP_LIBS}|" \
    src/Makevars.in > src/Makevars

exit 0
