CXX_STD = CXX17

# netCDF, and the HDF5, curl and compression libraries it links, come with
# Rtools (R >= 4.2, UCRT); pkg-config gives the static link line. Nothing is
# downloaded at build time.
PKG_CONFIG ?= $(BINPREF)pkg-config
NETCDF_LIBS := $(shell $(PKG_CONFIG) --libs --static netcdf 2>/dev/null)

ifneq ($(NETCDF_LIBS),)
PKG_CPPFLAGS = $(shell $(PKG_CONFIG) --cflags netcdf)
PKG_LIBS = $(NETCDF_LIBS)
else
PKG_LIBS = -lnetcdf -lhdf5_hl -lhdf5 -lcurl -lssh2 -lssl -lcrypto -lxml2 -lexpat -lintl -lz \
	-lws2_32 -lcrypt32 -lwldap32 -ladvapi32 -luser32 -lnormaliz -liconv
endif
